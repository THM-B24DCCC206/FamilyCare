private const val OCR_TAG = "FamilyCareOCR"

private data class MedicineCatalogEntry(
    val name: String,
    val aliases: List<String>
)

/**
 * Danh mục thuốc mẫu.
 * Có thể bổ sung tên thuốc và hoạt chất vào danh sách này.
 */
private val medicineCatalog = listOf(
    MedicineCatalogEntry(
        "YESOM 40mg",
        listOf("YESOM", "ESOMEPRAZOL")
    ),
    MedicineCatalogEntry(
        "SUCRATE GEL",
        listOf("SUCRATE GEL", "SUCRALFATE")
    ),
    MedicineCatalogEntry(
        "ARTHUR",
        listOf("ARTHUR", "TRIMEBUTINE")
    ),
    MedicineCatalogEntry(
        "PAPAZE",
        listOf("PAPAZE")
    ),
    MedicineCatalogEntry(
        "BIOCID MH 3.5+2g",
        listOf("BIOCID MH", "BIOCID")
    ),
    MedicineCatalogEntry(
        "DIGLUMISAN",
        listOf("DIGLUMISAN", "L-ARGININE")
    )
)

private fun normalizeMedicineText(text: String): String {
    return Normalizer.normalize(
        text.uppercase(),
        Normalizer.Form.NFD
    )
        .replace(Regex("\\p{Mn}+"), "")
        .replace('Đ', 'D')
        .replace(Regex("[^A-Z0-9]+"), " ")
        .trim()
}

private fun levenshteinDistance(
    first: String,
    second: String
): Int {
    var previous = IntArray(second.length + 1) { it }

    for (i in first.indices) {
        val current = IntArray(second.length + 1)
        current[0] = i + 1

        for (j in second.indices) {
            val cost = if (first[i] == second[j]) 0 else 1
            current[j + 1] = minOf(
                current[j] + 1,
                previous[j + 1] + 1,
                previous[j] + cost
            )
        }

        previous = current
    }

    return previous[second.length]
}

private fun findMedicineInLine(
    line: String
): MedicineCatalogEntry? {
    val normalizedLine = normalizeMedicineText(line)
    if (normalizedLine.isBlank()) return null

    // Ưu tiên khớp chính xác trước.
    val exactMatches = medicineCatalog.mapNotNull { entry ->
        val matchedAlias = entry.aliases
            .map { normalizeMedicineText(it) }
            .filter { alias ->
                Regex(
                    "(^| )${Regex.escape(alias)}( |$)"
                ).containsMatchIn(normalizedLine)
            }
            .maxByOrNull { it.length }

        if (matchedAlias != null) {
            entry to matchedAlias.length
        } else {
            null
        }
    }

    if (exactMatches.isNotEmpty()) {
        return exactMatches.maxByOrNull { it.second }?.first
    }

    // So khớp gần đúng khi OCR đọc nhầm một vài ký tự.
    val tokens = normalizedLine.split(Regex("\\s+"))
        .filter { it.isNotBlank() }

    var bestEntry: MedicineCatalogEntry? = null
    var bestDistance = Int.MAX_VALUE
    var bestLength = 0

    for (entry in medicineCatalog) {
        for (alias in entry.aliases) {
            val expectedTokens = normalizeMedicineText(alias)
                .split(Regex("\\s+"))
                .filter { it.isNotBlank() }

            if (expectedTokens.isEmpty() ||
                tokens.size < expectedTokens.size
            ) continue

            for (start in 0..(tokens.size - expectedTokens.size)) {
                val actualTokens = tokens.subList(
                    start,
                    start + expectedTokens.size
                )

                var totalDistance = 0
                var acceptable = true

                for (i in expectedTokens.indices) {
                    val expected = expectedTokens[i]
                    val actual = actualTokens[i]

                    val allowed = when {
                        expected.length < 4 -> 0
                        expected.length < 9 -> 1
                        else -> 2
                    }

                    if (
                        kotlin.math.abs(expected.length - actual.length) > allowed
                    ) {
                        acceptable = false
                        break
                    }

                    val distance = levenshteinDistance(expected, actual)

                    if (distance > allowed) {
                        acceptable = false
                        break
                    }

                    totalDistance += distance
                }

                if (!acceptable) continue

                val aliasLength = expectedTokens.sumOf { it.length }

                if (
                    totalDistance < bestDistance ||
                    (
                        totalDistance == bestDistance &&
                        aliasLength > bestLength
                    )
                ) {
                    bestEntry = entry
                    bestDistance = totalDistance
                    bestLength = aliasLength
                }
            }
        }
    }

    return bestEntry
}

private fun suggestMedicineName(text: String): String? {
    return findMedicineInLine(text)?.name
}

/**
 * Tách nội dung OCR thành các mục thuốc dựa trên tên thuốc
 * trong danh mục và số thứ tự từ 1 đến 6.
 */
private fun extractMedicineCandidates(
    text: String
): List<String> {
    val result = mutableListOf<String>()
    val lines = text.lines()
        .map { it.trim() }
        .filter { it.isNotBlank() }

    val numberedStart = Regex(
        """^\s*([1-9])\s*[.)]\s*(.*)$"""
    )

    val stopWords = listOf(
        "HO TEN", "HỌ TÊN", "BENH NHAN", "BỆNH NHÂN",
        "DIA CHI", "ĐỊA CHỈ", "CHAN DOAN", "CHẨN ĐOÁN",
        "CHUAN DOAN", "NGAY KHAM", "NGÀY KHÁM",
        "GIOI TINH", "GIỚI TÍNH", "TUOI", "TUỔI",
        "BAC SI", "BÁC SĨ", "DON THUOC", "ĐƠN THUỐC",
        "CHANDOAN", "DI UNG", "DỊ ỨNG", "TIEN SU",
        "TIỀN SỬ", "LOI DAN", "LỜI DẶN"
    )

    val dosagePattern = Regex(
        """(?i)\b\d+(?:[.,]\d+)?\s*(mg|mcg|g|ml|iu|ui|%)\b"""
    )

    var current = StringBuilder()

    fun saveCurrent() {
        val candidate = current.toString().trim()
        if (candidate.isNotBlank()) {
            result.add(candidate)
        }
        current = StringBuilder()
    }

    for (line in lines) {
        val normalized = normalizeMedicineText(line)
        if (stopWords.any { normalized.contains(normalizeMedicineText(it)) }) {
            continue
        }

        if (normalized.length < 3) continue

        val numbered = numberedStart.matchEntire(line)
        val content = numbered?.groupValues?.get(2)?.trim().orEmpty()
        val lineToCheck = if (content.isNotBlank()) content else line
        val medicineMatch = findMedicineInLine(lineToCheck)

        // Chỉ nhận dòng có thuốc thuộc danh mục đã biết.
        if (medicineMatch != null) {
            val newMedicine = numbered != null || current.isNotEmpty()
            if (newMedicine) saveCurrent()
            current.append(lineToCheck)
            continue
        }

        // Chỉ nối thêm thông tin liều dùng vào thuốc đã nhận diện.
        if (current.isNotEmpty() && (
            dosagePattern.containsMatchIn(line) ||
            normalized.startsWith("UONG ") ||
            normalized.startsWith("NGAY ") ||
            normalized.startsWith("SANG ") ||
            normalized.startsWith("CHIEU ") ||
            normalized.startsWith("TOI ") ||
            normalized.startsWith("TRUOC AN") ||
            normalized.startsWith("SAU AN")
        )) {
            current.append("\n").append(line)
        }
    }

    saveCurrent()

    return result.distinct()
}

@Composable
fun OcrPrescriptionScreen(
    onBack: () -> Unit
) {
    val context = LocalContext.current

    var selectedUri by remember { mutableStateOf<Uri?>(null) }
    var recognizedText by remember { mutableStateOf("") }
    var errorMessage by remember { mutableStateOf("") }
    var isProcessing by remember { mutableStateOf(false) }
    var showRawText by remember { mutableStateOf(false) }

    val medicineCandidates = remember {
        mutableStateListOf<String>()
    }

    val imagePicker = rememberLauncherForActivityResult(
        contract = ActivityResultContracts.GetContent()
    ) { uri ->
        if (uri == null) {
            Log.d(OCR_TAG, "Người dùng đã hủy chọn ảnh")
        } else {
            selectedUri = uri
            recognizedText = ""
            medicineCandidates.clear()
            errorMessage = ""
            showRawText = false
            isProcessing = true

            try {
                val image = InputImage.fromFilePath(context, uri)
                val recognizer = TextRecognition.getClient(
                    TextRecognizerOptions.DEFAULT_OPTIONS
                )

                recognizer.process(image)
                    .addOnSuccessListener { result ->
                        recognizedText = result.text

                        medicineCandidates.clear()
                        medicineCandidates.addAll(
                            extractMedicineCandidates(result.text)
                        )

                        if (result.text.isBlank()) {
                            errorMessage =
                                "Không nhận diện được chữ. " +
                                    "Hãy thử ảnh rõ nét hơn."
                        } else if (medicineCandidates.isEmpty()) {
                            errorMessage =
                                "Chưa tách được mục thuốc tự động. " +
                                    "Bạn có thể thêm thuốc thủ công."
                        }
                    }
                    .addOnFailureListener { exception ->
                        Log.e(
                            OCR_TAG,
                            "Lỗi nhận diện văn bản OCR",
                            exception
                        )

                        errorMessage =
                            "Nhận diện thất bại: ${
                                exception.localizedMessage
                                    ?: "Lỗi không xác định"
                            }"
                    }
                    .addOnCompleteListener {
                        isProcessing = false
                        recognizer.close()
                    }
            } catch (exception: Exception) {
                isProcessing = false

                Log.e(
                    OCR_TAG,
                    "Không thể đọc ảnh đơn thuốc",
                    exception
                )

                errorMessage =
                    "Không thể mở ảnh: ${
                        exception.localizedMessage
                            ?: "Lỗi không xác định"
                    }"
            }
        }
    }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .verticalScroll(rememberScrollState())
            .padding(16.dp),
        verticalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        Text(
            text = "Quét đơn thuốc",
            style = MaterialTheme.typography.headlineSmall
        )

        Text(
            text = "Chọn ảnh đơn thuốc để nhận diện bằng ML Kit.",
            style = MaterialTheme.typography.bodyMedium,
            color = MaterialTheme.colorScheme.onSurfaceVariant
        )

        Button(
            onClick = {
                Log.d(OCR_TAG, "Đã bấm nút chọn ảnh")

                Toast.makeText(
                    context,
                    "Đang mở trình chọn ảnh...",
                    Toast.LENGTH_SHORT
                ).show()

                try {
                    imagePicker.launch("image/*")
                } catch (exception: Exception) {
                    Log.e(
                        OCR_TAG,
                        "Không thể mở trình chọn ảnh",
                        exception
                    )

                    Toast.makeText(
                        context,
                        "Không thể mở thư viện ảnh: ${
                            exception.localizedMessage
                                ?: "Lỗi không xác định"
                        }",
                        Toast.LENGTH_LONG
                    ).show()
                }
            },
            modifier = Modifier.fillMaxWidth(),
            enabled = !isProcessing
        ) {
            Text(
                if (selectedUri == null) {
                    "Chọn ảnh đơn thuốc"
                } else {
                    "Chọn ảnh khác"
                }
            )
        }

        if (selectedUri != null) {
            Text(
                text = "Đã chọn ảnh đơn thuốc",
                style = MaterialTheme.typography.bodySmall
            )
        }

        if (isProcessing) {
            Row(
                horizontalArrangement = Arrangement.spacedBy(12.dp)
            ) {
                CircularProgressIndicator()
                Text("Đang nhận diện văn bản...")
            }
        }

        if (errorMessage.isNotBlank()) {
            Text(
                text = errorMessage,
                color = MaterialTheme.colorScheme.error,
                style = MaterialTheme.typography.bodyMedium
            )
        }

        if (recognizedText.isNotBlank() && !isProcessing) {
            HorizontalDivider()

            Text(
                text = "Danh sách mục thuốc",
                style = MaterialTheme.typography.titleLarge
            )

            Text(
                text = "Đã tách ${medicineCandidates.size} mục. " +
                    "Tên thuốc gợi ý dựa trên danh mục mẫu; " +
                    "hãy kiểm tra với đơn gốc.",
                style = MaterialTheme.typography.bodySmall,
                color = MaterialTheme.colorScheme.onSurfaceVariant
            )
        }

        OutlinedButton(
            onClick = {
                medicineCandidates.add("")
            },
            modifier = Modifier.fillMaxWidth(),
            enabled = !isProcessing
        ) {
            Icon(
                imageVector = Icons.Default.Add,
                contentDescription = null
            )
            Text("Thêm thuốc thủ công")
        }

        medicineCandidates.forEachIndexed { index, medicine ->
            val suggestedName = suggestMedicineName(medicine)

            Card(
                modifier = Modifier.fillMaxWidth(),
                colors = CardDefaults.cardColors(
                    containerColor =
                        MaterialTheme.colorScheme.surfaceContainerLow
                )
            ) {
                Column(
                    modifier = Modifier.padding(12.dp),
                    verticalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.SpaceBetween
                    ) {
                        Text(
                            text = "Mục thuốc ${index + 1}",
                            style = MaterialTheme.typography.titleMedium
                        )

                        IconButton(
                            onClick = {
                                medicineCandidates.removeAt(index)
                            }
                        ) {
                            Icon(
                                imageVector = Icons.Default.Delete,
                                contentDescription = "Xóa mục thuốc"
                            )
                        }
                    }

                    if (suggestedName != null) {
                        Text(
                            text = "Tên thuốc gợi ý: $suggestedName",
                            style = MaterialTheme.typography.bodyMedium,
                            color = MaterialTheme.colorScheme.primary
                        )
                    }

                    OutlinedTextField(
                        value = medicine,
                        onValueChange = { updated ->
                            medicineCandidates[index] = updated
                        },
                        label = {
                            Text("Tên thuốc, liều lượng, cách dùng")
                        },
                        placeholder = {
                            Text("Nhập thông tin thuốc tại đây...")
                        },
                        modifier = Modifier.fillMaxWidth(),
                        minLines = 3
                    )
                }
            }
        }

        if (recognizedText.isNotBlank() && !isProcessing) {
            Card(
                modifier = Modifier.fillMaxWidth()
            ) {
                Column(
                    modifier = Modifier.padding(horizontal = 12.dp),
                    verticalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.SpaceBetween
                    ) {
                        TextButton(
                            onClick = {
                                showRawText = !showRawText
                            }
                        ) {
                            Text("Xem văn bản OCR gốc")
                        }

                        IconButton(
                            onClick = {
                                showRawText = !showRawText
                            }
                        ) {
                            Icon(
                                imageVector = if (showRawText) {
                                    Icons.Default.ExpandLess
                                } else {
                                    Icons.Default.ExpandMore
                                },
                                contentDescription = if (showRawText) {
                                    "Thu gọn văn bản OCR"
                                } else {
                                    "Mở rộng văn bản OCR"
                                }
                            )
                        }
                    }

                    AnimatedVisibility(visible = showRawText) {
                        OutlinedTextField(
                            value = recognizedText,
                            onValueChange = { updated ->
                                recognizedText = updated
                                medicineCandidates.clear()
                                medicineCandidates.addAll(
                                    extractMedicineCandidates(updated)
                                )
                            },
                            label = {
                                Text("Văn bản OCR gốc")
                            },
                            modifier = Modifier.fillMaxWidth(),
                            minLines = 5
                        )
                    }
                }
            }
        }

        Text(
            text = "OCR có thể nhận diện sai hoặc bỏ sót thuốc. " +
                "Hãy đối chiếu tên thuốc, liều lượng và cách dùng " +
                "với đơn gốc. Dữ liệu chưa được lưu vào cơ sở dữ liệu.",
            style = MaterialTheme.typography.bodySmall,
            color = MaterialTheme.colorScheme.error
        )

        Button(
            onClick = onBack,
            modifier = Modifier.fillMaxWidth()
        ) {
            Text("Quay lại")
        }
    }
}


